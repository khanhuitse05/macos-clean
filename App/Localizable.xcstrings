  "strings" : {
    "\"Cleaned\" counts items macos-clean moved to the Trash and simulators it removed. Emptying the Trash is counted apart, so nothing is counted twice." : {
      "comment" : "The footer text for the Cleaning History section in Settings.",
      "isCommentAutoGenerated" : true
    },
