require "fileutils"
require "shellwords"

ROOT_DIR = File.expand_path("..", __dir__)
PROJECT_YML = File.join(ROOT_DIR, "project.yml")
XCODEPROJ = File.join(ROOT_DIR, "macos-clean.xcodeproj")
EXPORT_OPTIONS = File.join(ROOT_DIR, "fastlane", "ExportOptions.plist")
RELEASE_DIR = File.join(ROOT_DIR, "build", "release")
ARCHIVE_PATH = File.join(RELEASE_DIR, "macos-clean.xcarchive")
EXPORT_DIR = File.join(RELEASE_DIR, "export")
APP_PATH = File.join(EXPORT_DIR, "macOS Clean.app")
DMG_PATH = File.join(RELEASE_DIR, "macos-clean.dmg")
SHA_PATH = "#{DMG_PATH}.sha256"
WEB_INDEX_HTML = File.join(ROOT_DIR, "web", "index.html")

DEFAULT_SIGNING_IDENTITY = "Developer ID Application: To Ngoc Khanh (N8L3QK9894)"
DEFAULT_GITHUB_REPO = "khanhuitse05/macos-clean"

def read_project_setting(key)
  content = File.read(PROJECT_YML)
  match = content.match(/^\s*#{Regexp.escape(key)}:\s*"?([^"\n]+)"?\s*$/)
  UI.user_error!("Could not find #{key} in #{PROJECT_YML}") unless match
  match[1].strip
end

def update_project_setting(key, value)
  content = File.read(PROJECT_YML)
  updated = content.sub(/^(\s*#{Regexp.escape(key)}:\s*)"?[^"\n]+"?(\s*)$/, "\\1\"#{value}\"\\2")
  UI.user_error!("Could not update #{key} in #{PROJECT_YML}") if updated == content
  File.write(PROJECT_YML, updated)
end

def signing_identity
  ENV.fetch("SIGNING_IDENTITY", DEFAULT_SIGNING_IDENTITY)
end

def github_repo
  return ENV["GITHUB_REPO"] if ENV["GITHUB_REPO"] && !ENV["GITHUB_REPO"].strip.empty?

  remote_url = Dir.chdir(ROOT_DIR) { `git remote get-url origin 2>/dev/null`.strip }
  if remote_url =~ %r{github\.com[:/]([^/]+/[^/]+?)(?:\.git)?$}
    return Regexp.last_match(1)
  end

  DEFAULT_GITHUB_REPO
end

def notary_credentials_configured?
  asc_configured = %w[ASC_KEY_PATH ASC_KEY_ID ASC_ISSUER_ID].all? { |k| ENV[k] && !ENV[k].strip.empty? }
  apple_id_configured = %w[APPLE_ID APPLE_APP_SPECIFIC_PASSWORD].all? { |k| ENV[k] && !ENV[k].strip.empty? }
  return true if asc_configured || apple_id_configured

  profile = ENV.fetch("NOTARY_PROFILE", "macos-clean-notary")
  system("xcrun notarytool history --keychain-profile #{Shellwords.escape(profile)} </dev/null >/dev/null 2>&1")
end

def verify_app_signature!(app_path)
  sh("codesign", "--verify", "--deep", "--strict", "--verbose=2", app_path)
  info = Actions.sh("codesign -dvvv #{Shellwords.escape(app_path)} 2>&1", log: false)

  unless info.include?("Authority=Developer ID Application")
    UI.user_error!("App is not signed with a Developer ID Application certificate:\n#{info}")
  end
  unless info.include?("flags=0x10000(runtime)")
    UI.user_error!("App is missing Hardened Runtime (flags=0x10000(runtime)):\n#{info}")
  end
  unless info.include?("Timestamp=")
    UI.user_error!("App signature is missing a secure timestamp:\n#{info}")
  end

  UI.success("Verified Developer ID signature, Hardened Runtime, and secure timestamp for #{File.basename(app_path)}")
end

default_platform(:mac)

platform :mac do
  desc "Run MacosCleanCore unit tests"
  lane :test do
    Dir.chdir(ROOT_DIR) do
      sh("xcrun", "swift", "test", "--package-path", "Packages/MacosCleanCore")
    end
  end

  desc "Regenerate macos-clean.xcodeproj from project.yml"
  lane :generate do
    Dir.chdir(ROOT_DIR) do
      sh("xcodegen", "generate")
    end
  end

  desc "Archive and export Release macOS Clean.app signed with Developer ID Application"
  lane :build do |options|
    test unless options[:skip_tests]

    if options[:version]
      update_project_setting("MARKETING_VERSION", options[:version].to_s)
    end
    if options[:build_number]
      update_project_setting("CURRENT_PROJECT_VERSION", options[:build_number].to_s)
    end

    generate

    FileUtils.rm_rf(RELEASE_DIR)
    FileUtils.mkdir_p(RELEASE_DIR)

    Dir.chdir(ROOT_DIR) do
      sh(
        "xcodebuild", "archive",
        "-project", XCODEPROJ,
        "-scheme", "macos-clean",
        "-configuration", "Release",
        "-destination", "generic/platform=macOS",
        "-archivePath", ARCHIVE_PATH
      )

      sh(
        "xcodebuild", "-exportArchive",
        "-archivePath", ARCHIVE_PATH,
        "-exportPath", EXPORT_DIR,
        "-exportOptionsPlist", EXPORT_OPTIONS
      )
    end

    UI.user_error!("Exported app not found at #{APP_PATH}") unless File.exist?(APP_PATH)
    verify_app_signature!(APP_PATH)
  end

  desc "Notarize macOS Clean.app, package signed macos-clean.dmg, notarize & staple DMG"
  lane :package_dmg do |options|
    UI.user_error!("Missing #{APP_PATH}. Run `fastlane build` first.") unless File.exist?(APP_PATH)

    notarize_enabled = options[:notarize].nil? ? notary_credentials_configured? : options[:notarize]
    notarize_script = File.join(ROOT_DIR, "scripts", "notarize.sh")
    create_dmg_script = File.join(ROOT_DIR, "scripts", "create_dmg.sh")

    Dir.chdir(ROOT_DIR) do
      if notarize_enabled
        app_zip = File.join(RELEASE_DIR, "macos-clean-app.zip")
        FileUtils.rm_f(app_zip)
        sh("ditto", "-c", "-k", "--keepParent", APP_PATH, app_zip)
        sh(notarize_script, app_zip, APP_PATH)
        FileUtils.rm_f(app_zip)
      elsif options[:notarize] == false
        UI.important("Skipping notarization (notarize:false). Users will see a Gatekeeper warning on download.")
      else
        UI.important("No Apple notarization credentials configured (NOTARY_PROFILE / ASC_KEY_* / APPLE_ID); skipping notarization. Run ./scripts/setup_notary.sh to enable Apple notarization.")
      end

      sh(create_dmg_script, APP_PATH, DMG_PATH, signing_identity)

      if notarize_enabled
        sh(notarize_script, DMG_PATH, DMG_PATH)
        sh("spctl", "-a", "-vvv", "-t", "exec", APP_PATH)
        sh("spctl", "-a", "-vvv", "-t", "open", "--context", "context:primary-signature", DMG_PATH)
        UI.success("Gatekeeper assessment passed for both macOS Clean.app and macos-clean.dmg!")
      end

      sha_digest = Actions.sh("shasum -a 256 #{Shellwords.escape(DMG_PATH)}", log: false).split.first
      File.write(SHA_PATH, "#{sha_digest}  #{File.basename(DMG_PATH)}\n")
      UI.message("SHA-256: #{sha_digest}  #{File.basename(DMG_PATH)}")
    end
  end

  desc "Update web/index.html version, commit, and push so GitHub Pages deploys"
  lane :publish_release do |options|
    UI.user_error!("Missing #{DMG_PATH}. Run `fastlane package_dmg` first.") unless File.exist?(DMG_PATH)

    version = options[:version]&.to_s || read_project_setting("MARKETING_VERSION")
    if File.exist?(WEB_INDEX_HTML)
      html = File.read(WEB_INDEX_HTML)
      updated_html = html
        .gsub(%r{(<span class="version-pill">)v[^<]+(</span>)}, "\\1v#{version}\\2")
        .gsub(/v\d+(?:\.\d+)*(\s*·\s*Universal)/, "v#{version}\\1")
      File.write(WEB_INDEX_HTML, updated_html) if updated_html != html
    end

    commit_message = options[:commit_message]&.to_s || "Release macOS Clean v#{version}"
    Dir.chdir(ROOT_DIR) do
      paths_to_stage = ["web/index.html", "project.yml"].select { |p| File.exist?(p) }
      sh("git", "add", *paths_to_stage) unless paths_to_stage.empty?
      if system("git diff --cached --quiet")
        UI.message("No landing-page or version changes to commit")
      else
        sh("git", "commit", "-m", commit_message)
      end
      sh("git", "push", "-u", "origin", "main") unless options[:skip_push]
    end

    owner, repo_name = github_repo.split("/", 2)
    UI.success("Updated web landing page for v#{version}")
    if owner && repo_name
      UI.success("GitHub Pages URL: https://#{owner}.github.io/#{repo_name}/")
    end
  end

  desc "Upload macos-clean.dmg to GitHub Releases via gh CLI"
  lane :github_release do |options|
    dmg_path = DMG_PATH
    UI.user_error!("Missing #{dmg_path}. Run `fastlane package_dmg` first.") unless File.exist?(dmg_path)

    sha_path = File.exist?(SHA_PATH) ? SHA_PATH : nil
    version = options[:version]&.to_s || read_project_setting("MARKETING_VERSION")
    tag = "v#{version}"
    repo = github_repo
    draft = options[:draft] ? true : false
    prerelease = options[:prerelease] ? true : false

    Dir.chdir(ROOT_DIR) do
      sh("gh", "auth", "status")

      sha = sha_path ? File.read(sha_path).split.first : ""
      notarized = system("xcrun stapler validate #{Shellwords.escape(dmg_path)} >/dev/null 2>&1")
      signing_note = if notarized
        "Universal macOS app (Apple Silicon & Intel), signed with Developer ID and notarized by Apple."
      else
        "Universal macOS app (Apple Silicon & Intel), signed with Developer ID Application (Hardened Runtime)."
      end
      notes = <<~NOTES
        ## macOS Clean #{tag}

        - #{signing_note}
        - Install: open `macos-clean.dmg` and drag `macOS Clean.app` to `/Applications`.

        ### Verification
        ```bash
        codesign -dv --verbose=4 "/Applications/macOS Clean.app"
        ```
        SHA-256 (`macos-clean.dmg`): `#{sha}`
      NOTES

      assets = [dmg_path, sha_path].compact
      exists = system("gh release view #{Shellwords.escape(tag)} --repo #{Shellwords.escape(repo)} >/dev/null 2>&1")
      if exists
        UI.important("Release #{tag} already exists on #{repo}; uploading updated assets...")
        sh("gh", "release", "upload", tag, *assets, "--repo", repo, "--clobber")
        sh("gh", "release", "edit", tag, "--repo", repo, "--notes", notes)
      else
        cmd = [
          "gh", "release", "create", tag,
          *assets,
          "--repo", repo,
          "--title", "macOS Clean #{tag}",
          "--notes", notes,
          "--generate-notes"
        ]
        cmd << "--draft" if draft
        cmd << "--prerelease" if prerelease
        sh(*cmd)
      end

      UI.success("Published #{tag} to https://github.com/#{repo}/releases/tag/#{tag}")
      UI.success("Direct download URL: https://github.com/#{repo}/releases/latest/download/macos-clean.dmg")
    end
  end

  desc "Full release pipeline: test -> Developer ID build -> notarize & DMG -> update web & push -> GitHub Release"
  lane :release do |options|
    build(options)
    package_dmg(options)
    publish_release(options)
    github_release(options) unless options[:skip_github_release]
  end
end
