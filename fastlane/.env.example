# Copy to fastlane/.env (gitignored) or export in your shell.
# Recommended: store a keychain profile once via ./scripts/setup_notary.sh

# Option 1: Keychain profile created with `xcrun notarytool store-credentials`
NOTARY_PROFILE=macos-clean-notary

# Option 2: App Store Connect API Key (.p8)
# ASC_KEY_PATH=/path/to/AuthKey_XXXXXXXXXX.p8
# ASC_KEY_ID=XXXXXXXXXX
# ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Option 3: Apple ID + App-Specific Password (generate at appleid.apple.com)
# APPLE_ID=you@example.com
# APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
# APPLE_TEAM_ID=N8L3QK9894

# Signing & release repo defaults
SIGNING_IDENTITY="Developer ID Application: To Ngoc Khanh (N8L3QK9894)"
RELEASE_REPO_DIR=../maos-clean-release
GITHUB_REPO=khanhuitse05/macos-clean-release
