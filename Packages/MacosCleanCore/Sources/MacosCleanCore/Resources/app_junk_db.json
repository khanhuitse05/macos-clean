{
  "version": 1,
  "comment": "Curated junk-path database for popular macOS apps. 'match' entries: exact bundle id, exact app name (case-insensitive), or bundle-id prefix when ending in '*'. 'leftovers' = [category, path] pairs found ONLY during uninstall (categories: logs|preferences|caches|supporting). 'safe_caches' = paths safe to clear while the app stays installed (app should be quit). Paths support ~ and single-component * globs. Deliberately excludes anything directly under ~/Library/Caches/<bundle-id|name> (generic heuristics and the user-caches category already cover those).",
  "apps": [
    {
      "name": "Google Chrome",
      "match": ["com.google.Chrome", "Google Chrome"],
      "leftovers": [
        ["supporting", "~/Library/Application Support/Google/Chrome"],
        ["caches", "~/Library/Caches/Google/Chrome"],
        ["supporting", "~/Library/Google/GoogleSoftwareUpdate"]
      ],
      "safe_caches": [
        "~/Library/Application Support/Google/Chrome/*/Code Cache",
        "~/Library/Application Support/Google/Chrome/*/GPUCache",
        "~/Library/Application Support/Google/Chrome/GrShaderCache",
        "~/Library/Application Support/Google/Chrome/GraphiteDawnCache",
        "~/Library/Application Support/Google/Chrome/ShaderCache",
        "~/Library/Application Support/Google/Chrome/component_crx_cache",
        "~/Library/Application Support/Google/Chrome/Crashpad/completed"
